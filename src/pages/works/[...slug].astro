---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft && !data.externalOnly);
  return works.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'works'> };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="article-page page-shell">
    <a class="text-link article-page__back" href="/works/">返回作品</a>
    <header>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
