---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesArticleTransition from '../../components/NotesArticleTransition.astro';
import NotesMarkdownCopy from '../../components/NotesMarkdownCopy.astro';
import '../../styles/notes-article-transition.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'notes'> };
const { Content } = await render(entry);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Shanghai',
});
const formattedDate = entry.data.publishedAt
  ? dateFormatter.format(entry.data.publishedAt).replaceAll('/', '.')
  : null;
---

<BaseLayout title={entry.data.title} description={entry.data.summary ?? entry.data.title} transitions>
  <NotesArticleTransition />
  <article class="notes-article page-shell" data-note-id={entry.id}>
    <a class="notes-article__back" href="/notes/">← 全部文章</a>
    <div class="notes-article__meta">
      {entry.data.publishedAt && formattedDate && (
        <time class="notes-article__date" datetime={entry.data.publishedAt.toISOString()}>{formattedDate}</time>
      )}
      <NotesMarkdownCopy markdown={entry.body ?? ''} />
    </div>
    <h1 class="notes-article__title">{entry.data.title}</h1>
    {entry.data.cover && (
      <div class="notes-article__cover" style="view-transition-name: article-cover;">
        <Image
          src={entry.data.cover}
          alt={entry.data.coverAlt ?? ''}
          widths={[670, 756, 1340, 1512]}
          sizes="(min-width: 52rem) 756px, calc(100vw - 3rem)"
          loading="eager"
          decoding="async"
          quality={90}
        />
      </div>
    )}
    <div class="notes-article__body"><Content /></div>
    <div class="notes-article__end">
      <a href="/notes/">← 返回全部文章</a>
    </div>
  </article>
</BaseLayout>
