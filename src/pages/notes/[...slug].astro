---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'notes'> };
const { Content } = await render(entry);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="article-page page-shell">
    <a class="text-link article-page__back" href="/notes/">返回笔记</a>
    <header>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <div class="article-page__meta">
        {entry.data.publishedAt && <time datetime={entry.data.publishedAt.toISOString()}>{dateFormatter.format(entry.data.publishedAt)}</time>}
        {entry.data.tags.length > 0 && (
          <span class="content-list__tags" aria-label="标签">
            {entry.data.tags.map((tag) => <span class="note-tag">{tag}</span>)}
          </span>
        )}
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
