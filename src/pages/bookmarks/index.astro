---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/content-hubs.css';

const bookmarks = (await getCollection('bookmarks', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Bookmarks" description="Muzi 收藏的网站、工具与项目。">
  <section class="hub-page page-shell" aria-labelledby="bookmarks-title">
    <h1 id="bookmarks-title" class="sr-only">Bookmarks</h1>
    <header class="bookmarks-head">
      <p class="page-label">收藏 · Bookmarks</p>
      <p class="bookmarks-head__count">{bookmarks.length} 个收藏</p>
    </header>

    {bookmarks.length > 0 ? (
      <ul class="bookmark-grid">
        {bookmarks.map((bookmark, index) => (
          <li>
            <a
              class="bookmark-card"
              href={bookmark.data.url}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`${bookmark.data.title}：打开链接（在新标签页打开）`}
            >
              {bookmark.data.cover && (
                <span class="bookmark-card__cover" aria-hidden="true">
                  <Image
                    src={bookmark.data.cover}
                    alt=""
                    widths={[360, 540, 720]}
                    sizes="(min-width: 60rem) 33vw, (min-width: 48rem) 50vw, calc(100vw - 2.5rem)"
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    quality={85}
                  />
                </span>
              )}
              <span class="bookmark-card__body">
                <h2>{bookmark.data.title}</h2>
                {bookmark.data.summary && <p>{bookmark.data.summary}</p>}
                <span class="bookmark-card__action">打开链接 <span aria-hidden="true">↗</span></span>
              </span>
            </a>
            {bookmark.data.cover && (
              <span class="bookmark-card__zoom" aria-hidden="true">
                <Image
                  src={bookmark.data.cover}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="26rem"
                  loading="lazy"
                  decoding="async"
                  quality={85}
                />
              </span>
            )}
          </li>
        ))}
      </ul>
    ) : <p class="empty-state hub-empty">收藏链接正在整理中。</p>}
  </section>
</BaseLayout>

<script>
  // 悬浮预览防截断：面板默认居中于卡片，超出 section 横向边界时平移回来
  const section = document.querySelector('.hub-page');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (section && finePointer) {
    const pad = 8;
    document.querySelectorAll('.bookmark-grid > li').forEach((li) => {
      const zoom = li.querySelector('.bookmark-card__zoom');
      if (!zoom) return;
      li.addEventListener('mouseenter', () => {
        const s = section.getBoundingClientRect();
        const c = li.getBoundingClientRect();
        const w = zoom.offsetWidth;
        const left = c.left + c.width / 2 - w / 2;
        let dx = 0;
        if (left < s.left + pad) dx = s.left + pad - left;
        else if (left + w > s.right - pad) dx = s.right - pad - left - w;
        zoom.style.setProperty('--zoom-dx', `${dx.toFixed(1)}px`);
      });
      li.addEventListener('mouseleave', () => {
        zoom.style.setProperty('--zoom-dx', '0px');
      });
    });
  }
</script>
