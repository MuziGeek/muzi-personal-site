---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'notes'>[];
}

const { entries } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const accessibleDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
});
---

<ol class="notes-timeline" aria-label="按发布时间倒序排列的笔记">
  {entries.map((entry, index) => {
    const publishedAt = entry.data.publishedAt!;
    const cover = entry.data.cover!;
    const coverAlt = entry.data.coverAlt!;
    const formattedDate = dateFormatter.format(publishedAt);
    const accessibleDate = accessibleDateFormatter.format(publishedAt);

    return (
      <li class="notes-timeline__item" data-side={index % 2 === 0 ? 'left' : 'right'}>
        <time class="notes-timeline__date" datetime={publishedAt.toISOString()}>
          {formattedDate}
        </time>
        <a
          class="notes-timeline__cover"
          href={`/notes/${entry.id}/`}
          aria-label={`${accessibleDate}，${entry.data.title}`}
        >
          <Image
            src={cover}
            alt={coverAlt}
            widths={[320, 480, 640, 800]}
            sizes="(min-width: 64rem) 42vw, calc(100vw - 5.5rem)"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            quality={88}
          />
        </a>
      </li>
    );
  })}
</ol>
