---
interface Props {
  title: string;
  image: string;
  imageAlt: string;
  description: string;
  href: string;
  linkLabel: string;
}

const { title, image, imageAlt, description, href, linkLabel } = Astro.props;
---

<header class="section-intro">
  <img class="section-intro__image" src={image} width="256" height="256" alt={imageAlt} loading="lazy" decoding="async" />
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
    <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
  </div>
</header>
